# HTTP listen address.
SERVER_ADDR=:8080

# Environment: dev, staging, or production.
# Production requires JWT_SECRET to be set to a strong non-default value.
APP_ENV=dev

# Postgres DSN. Required for the API server and migration command.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cpdhub?sslmode=disable

# JWT signing secret. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed CORS origins.
# Use explicit web origins in production; "*" is intended for local development.
CORS_ORIGINS=*

# Apply migrations automatically on server boot.
# Prefer the deploy release command in production, especially with multiple instances.
AUTO_MIGRATE=false
